  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 3600
  },
  "pinData": {},
  "meta": {
    "talon": {
      "contract": "Action Gateway /v1/action-operations (#458, #205)",
      "action": "create_refund_request",
      "n8n_node_versions": "webhook 2, httpRequest 4.2, switch 3.2, wait 1.1, respondToWebhook 1.1, stopAndError 1"
